{
  "name": "sidenote-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sidenote backend, phase 1: an uploaded lecture recording becomes notes. See DESIGN.md.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "invite": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/invite.ts",
    "costs": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/costs.ts",
    "compare-stt": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/compare-stt.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "busboy": "^1.6.0",
    "hono": "^4.13.18",
    "opencc-js": "^1.4.2",
    "pdfjs-dist": "^6.5.438",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
