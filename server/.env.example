# Copy to server/.env and fill in the keys. server/.env is not committed (see .gitignore).
# Every setting except the keys has a default; the defaults are shown.

# --- Keys ---
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# Only to compare services (README.md "对比转写服务") or to switch STT_PROVIDER to them
SONIOX_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPSEEK_API_KEY=
# Sign-in emails (resend.com). Empty: the codes are printed in this server's console instead (fine on your own computer only).
RESEND_API_KEY=
# A sender on a domain verified in Resend. Resend's test sender onboarding@resend.dev only delivers to your own Resend address.
# MAIL_FROM=Halfold <onboarding@resend.dev>
# Stripe, test mode (sk_test_...). Empty: plans are shown, choosing one says checkout is not connected yet.
# A live key (sk_live_...) is refused unless STRIPE_ALLOW_LIVE=on.
STRIPE_SECRET_KEY=
# The signing secret (whsec_...) of the webhook https://<server>/api/stripe/webhook, or the one `stripe listen` prints
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=off

# --- Server ---
# PORT=8787
# the address to listen on; empty = every address. 127.0.0.1 behind a reverse proxy (deploy/server sets it)
# HOST=
# database and lecture files, relative to server/
# DATA_DIR=data
# the built front end, served at "/"; empty = API only
# WEB_DIR=../dist
# "today", lecture dates and exam dates
# APP_TIMEZONE=Asia/Hong_Kong
# same as the front end's MAX_UPLOAD_MB
# MAX_UPLOAD_MB=500
# Plans: what each one allows (live minutes a day, lectures and review packs a month, how long recordings are kept)
# and costs. DAILY_LIVE_MINUTES and AUDIO_KEEP_DAYS moved there.
# PLANS_FILE=plans.json
# where students reach the server, e.g. https://sidenote.example.com; empty = playback links relative to the page
# PUBLIC_URL=
# where the front end is, for shared links (https://.../#/s/<id>); empty = the page the student shared from.
# Needed when the front end is served under a path, e.g. https://uni.example.com/sidenote/
# WEB_URL=
# the shared lecture behind "Example notes" on the public pages (the id at the end of its shared link); empty hides them
# EXAMPLE_SHARE_ID=
# where students write to you: shown on the Privacy page, and given (with PUBLIC_URL) to sites that ask downloaders to say
# who they are (Wikimedia refuses video links otherwise). Empty: the Privacy page says it is still to be decided.
# CONTACT_EMAIL=
# lectures processed at the same time
# PIPELINE_CONCURRENCY=2

# Invite codes, comma separated. Each code is one student account. More: npm run invite -- add <code>
INVITE_CODES=

# --- Signing in (phase 4) ---
# email: a 6-digit code sent to the student's email, and an invite code the first time. invite: the invite code alone.
# SIGN_IN=email
# only addresses ending in these may sign in, comma separated (subdomains too); empty = any address
# EMAIL_DOMAINS=connect.hku.hk,link.cuhk.edu.hk
# LOGIN_CODE_MINUTES=10
# codes sent in an hour, all addresses together
# LOGIN_CODES_PER_HOUR=300
# a sign-in ends after this many days without using Sidenote
# SESSION_DAYS=90

# --- Speech to text ---
# deepgram | elevenlabs | soniox | assemblyai
# STT_PROVIDER=deepgram
# scribe_v3 takes a second language (Cantonese or Mandarin + English); scribe_v2 does not
# ELEVENLABS_MODEL=scribe_v3
# ELEVENLABS_USD_PER_HOUR=0.2
# DEEPGRAM_MODEL=nova-3
# mixed classes on multi: zh-HK or zh alone drops most of the English
# DEEPGRAM_LANGUAGES=en:en,en-yue:multi,en-zh:multi,auto:multi
# monolingual
# DEEPGRAM_USD_PER_HOUR=0.258
# language=multi
# DEEPGRAM_USD_PER_HOUR_MULTI=0.312
# Soniox async; Chinese is one language (zh), Cantonese not listed separately
# SONIOX_MODEL=stt-async-v6
# SONIOX_USD_PER_HOUR=0.1
# assemblyai-stt-3-7 (US$0.21/h): Cantonese, and Chinese words inside English sentences. universal-2 (US$0.15/h) drops
# those (README.md "对比转写服务"). The price follows the model
# ASSEMBLYAI_MODEL=assemblyai-stt-3-7
# ASSEMBLYAI_USD_PER_HOUR=0.21

# --- Video links ---
# the yt-dlp program; when it is not found, link lectures are refused (501) and students upload instead
# YTDLP=yt-dlp
# how long one download may take before the lecture is marked failed
# LINK_DOWNLOAD_MINUTES=30
# downloads at once; counted apart from PIPELINE_CONCURRENCY, so a slow download never holds up other lectures' notes
# LINK_CONCURRENCY=2

# --- Live recording (phase 2) ---
# off: students cannot start a recording in Sidenote (they upload instead)
# LIVE_RECORDING=on
# off: no live transcript, live exam alerts or Catch me up while recording; the notes are the same
# LIVE_TRANSCRIPT=on
# one piece of a live recording (the front end sends one every 15 seconds)
# MAX_CHUNK_MB=10
# how long a chunk's reply waits for the live transcript it started
# LIVE_REPLY_WAIT_MS=8000
# live transcription rounds at once, all lectures together
# LIVE_CONCURRENCY=4
# Catch me up: a small fast model, no thinking
# CATCHUP_MODEL=deepseek-flash
# CATCHUP_REASONING_EFFORT=none
# CATCHUP_MAX_TOKENS=2000
# CATCHUP_USD_PER_M_INPUT=0.3
# CATCHUP_USD_PER_M_INPUT_CACHE_HIT=0.006
# CATCHUP_USD_PER_M_OUTPUT=1.2

# --- Playback ---
# (how long recordings are kept: audioDays in plans.json)
# how long a playback link works
# AUDIO_LINK_HOURS=12

# --- Notes ---
# or deepseek-flash
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# none | low | high | max
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=131072
# a Chinese explanation under every point; off to measure what it costs
# ZH_EXPLANATIONS=on
# Prices per million tokens at peak time (off-peak is half). Defaults follow the model.
# DEEPSEEK_USD_PER_M_INPUT=1.32
# DEEPSEEK_USD_PER_M_INPUT_CACHE_HIT=0.044
# DEEPSEEK_USD_PER_M_OUTPUT=3.96
