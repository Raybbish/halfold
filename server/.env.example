# Copy to server/.env and fill in the keys. server/.env is not committed (see .gitignore).
# Every setting except the keys has a default; the defaults are shown.

# --- Keys ---
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=

# --- Server ---
# PORT=8787
# database and lecture files, relative to server/
# DATA_DIR=data
# the built front end, served at "/"; empty = API only
# WEB_DIR=../dist
# "today", lecture dates and exam dates
# APP_TIMEZONE=Asia/Hong_Kong
# same as the front end's MAX_UPLOAD_MB
# MAX_UPLOAD_MB=500
# live recording (record, tab) per student per day; uploads are not counted
# DAILY_LIVE_MINUTES=240
# where students reach the server, e.g. https://sidenote.example.com; empty = playback links relative to the page
# PUBLIC_URL=
# lectures processed at the same time
# PIPELINE_CONCURRENCY=2

# Invite codes, comma separated. Each code is one student account. More: npm run invite -- add <code>
INVITE_CODES=

# --- Speech to text ---
# elevenlabs | deepgram
# STT_PROVIDER=elevenlabs
# scribe_v3 takes a second language (Cantonese or Mandarin + English); scribe_v2 does not
# ELEVENLABS_MODEL=scribe_v3
# ELEVENLABS_USD_PER_HOUR=0.2
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGES=en:en,en-yue:zh-HK,en-zh:multi,auto:multi
# monolingual
# DEEPGRAM_USD_PER_HOUR=0.258
# language=multi
# DEEPGRAM_USD_PER_HOUR_MULTI=0.312

# --- Live recording (phase 2) ---
# off: students cannot start a recording in Sidenote (they upload instead)
# LIVE_RECORDING=on
# off: no live transcript, live exam alerts or Catch me up while recording; the notes are the same
# LIVE_TRANSCRIPT=on
# one piece of a live recording (the front end sends one every 15 seconds)
# MAX_CHUNK_MB=10
# how long a chunk's reply waits for the live transcript it started
# LIVE_REPLY_WAIT_MS=8000
# live transcription rounds at once, all lectures together
# LIVE_CONCURRENCY=4
# Catch me up: a small fast model, no thinking
# CATCHUP_MODEL=deepseek-flash
# CATCHUP_REASONING_EFFORT=none
# CATCHUP_MAX_TOKENS=2000
# CATCHUP_USD_PER_M_INPUT=0.3
# CATCHUP_USD_PER_M_INPUT_CACHE_HIT=0.006
# CATCHUP_USD_PER_M_OUTPUT=1.2

# --- Playback ---
# 0 = keep every recording; N = delete a lecture's recording N days after the lecture (once it has notes)
# AUDIO_KEEP_DAYS=0
# how long a playback link works
# AUDIO_LINK_HOURS=12

# --- Notes ---
# or deepseek-flash
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# none | low | high | max
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MAX_TOKENS=131072
# a Chinese explanation under every point; off to measure what it costs
# ZH_EXPLANATIONS=on
# Prices per million tokens at peak time (off-peak is half). Defaults follow the model.
# DEEPSEEK_USD_PER_M_INPUT=1.32
# DEEPSEEK_USD_PER_M_INPUT_CACHE_HIT=0.044
# DEEPSEEK_USD_PER_M_OUTPUT=3.96
