# Cloudflare R2 for the daily backup (backup.sh). setup.sh copies this to /etc/halfold/backup.env; edit it there with:
#   sudoedit /etc/halfold/backup.env
# With R2_BUCKET empty, the database copies stay on this server only (/var/backups/halfold): they help after a
# mistake, not after losing the disk.
#
# In the Cloudflare dashboard: R2 -> create a bucket; then, under R2's API tokens, create a token with
# "Object Read & Write" for that bucket only. It shows the Access Key ID, the Secret Access Key, and the account ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# database copies kept in R2, in days
# KEEP_REMOTE_DAYS=30
# database copies kept on this server
# KEEP_LOCAL=7
