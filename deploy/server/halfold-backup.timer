# Runs halfold-backup.service every day at 04:30 Hong Kong time, when nobody is in class. A day the server was off
# is caught up at the next start (Persistent).

[Unit]
Description=Daily Halfold backup

[Timer]
OnCalendar=*-*-* 04:30:00 Asia/Hong_Kong
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
