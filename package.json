{
  "name": "halfold-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Halfold web app: record a lecture and read notes filed under each slide, with flashcards, a quiz and exam dates.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node tests/run-all.js",
    "test:legacy": "node tests/run-all.js --target=legacy",
    "walkthrough": "node deploy/walkthrough/make-bundle.js"
  },
  "dependencies": {
    "react": "~19.2.9",
    "react-dom": "~19.2.9"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "opencc-js": "^1.4.2",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
